{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "China Notifiable Infectious Diseases Dictionary Row",
  "type": "object",
  "required": [
    "disease_id",
    "record_type",
    "is_notifiable_disease",
    "parent_disease_id",
    "disease_name_zh",
    "cisdcp_disease_name",
    "disease_name_en",
    "legal_class",
    "management_class",
    "report_time_limit_hours",
    "transmission_type"
  ],
  "additionalProperties": false,
  "properties": {
    "disease_id": {
      "type": "string",
      "pattern": "^NID-(?:[ABC]-[0-9]{3}(?:-S[0-9]{3})?|AGG-[0-9]{3})$"
    },
    "record_type": {
      "type": "string",
      "enum": ["notifiable_disease", "subtype", "alias", "aggregate"]
    },
    "is_notifiable_disease": {
      "type": "boolean"
    },
    "parent_disease_id": {
      "type": ["string", "null"],
      "pattern": "^NID-[ABC]-[0-9]{3}$"
    },
    "disease_name_zh": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^()]+$"
    },
    "cisdcp_disease_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^()]+$"
    },
    "disease_name_en": {
      "type": ["string", "null"]
    },
    "legal_class": {
      "type": ["string", "null"],
      "enum": ["甲类", "乙类", "丙类", null]
    },
    "management_class": {
      "type": ["string", "null"],
      "enum": [
        "甲类管理",
        "乙类管理",
        "乙类按甲类措施管理",
        "丙类管理",
        null
      ]
    },
    "report_time_limit_hours": {
      "type": ["integer", "null"],
      "enum": [2, 24, null]
    },
    "transmission_type": {
      "type": ["string", "null"],
      "enum": ["呼吸道传染病", "肠道传染病", null]
    }
  }
}
